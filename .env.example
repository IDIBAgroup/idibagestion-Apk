# MySQL connection string. Keep production credentials in the deployment secret store.
DATABASE_URL=mysql://user:password@localhost:3306/idibages

# Google OAuth client (Web application). Register this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_LOGIN_HINT=idibagroup2020@gmail.com
GOOGLE_ADMIN_EMAIL=idibagroup2020@gmail.com

# Design phase: `npm run dev` signs in a fake admin with demo plans/company (no database needed).
# Never active in production builds. Set DESIGN_MODE=0 to use real authentication in dev.
# DESIGN_MODE=0

# Private document storage (S3-compatible; bucket must remain private).
# Uploads are rejected unless both storage and antivirus settings are present.
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=us-east-1
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# Antivirus endpoint accepts the raw file body and returns JSON { "clean": true }.
DOCUMENTS_ANTIVIRUS_URL=
DOCUMENTS_ANTIVIRUS_TOKEN=

# SendGrid transactional e-mail used for external one-time access codes.
DOCUMENTS_EMAIL_API_KEY=
DOCUMENTS_EMAIL_FROM=

# DocuSign JWT grant for server-to-server signature requests.
# Grant API consent to the impersonated DocuSign user before enabling in production.
DOCUMENTS_DOCUSIGN_INTEGRATION_KEY=
DOCUMENTS_DOCUSIGN_USER_ID=
DOCUMENTS_DOCUSIGN_ACCOUNT_ID=
# Store the full RSA private key as a Vercel secret; represent line breaks as \n.
DOCUMENTS_DOCUSIGN_PRIVATE_KEY=
# Sandbox defaults to account-d.docusign.com / https://demo.docusign.net.
DOCUMENTS_DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUMENTS_DOCUSIGN_BASE_URI=https://demo.docusign.net
